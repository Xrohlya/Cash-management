# Скопируйте файл в .env. Не добавляйте .env в git.
BOT_TOKEN=
BOT_NAME=Мой Бюджет

# Публичный HTTPS-адрес API и Mini App, например https://cash-management-api.onrender.com
WEBAPP_URL=
ALLOWED_ORIGINS=

# Service URI PostgreSQL из Aiven с sslmode=require.
DATABASE_URL=
SQLITE_PATH=data/budget.db
DB_POOL_MAX=10
SIRI_API_TOKEN=
SIRI_USER_ID=

DEFAULT_MANDATORY_PERCENT=6
INIT_DATA_TTL_SECONDS=86400
